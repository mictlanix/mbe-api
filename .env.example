APP_NAME=mbe-api
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+aiomysql://user:password@localhost/mbe

# Required. Every stored datetime is naive wall-clock time in this zone, the same zone the legacy
# monolith writes into the shared database. The API refuses to start without it (#228).
BUSINESS_TIMEZONE=America/Mexico_City

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_RECOVERY_TOKEN_EXPIRE_HOURS=24

# Password strength (#241): enforced whenever a password is set (user create, change-password,
# recover) and published at GET /auth/password-policy. Existing passwords keep working.
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false

USER_SETTINGS_MODE=Managed

# Delivery (spec 012). Spec 013 retired IN_TRANSIT_WAREHOUSE_ID: there is one in-transit
# location per facility now, found by its flag, so there is nothing left to configure.
DELIVERY_ORDER_APPROVAL_REQUIRED=false
# Assumes payment precedes fulfilment on every channel: with it on, an order on immediate terms
# paid on receipt — ordinary cash-on-delivery — cannot be delivered at all unless the customer has
# credit terms. Leave it off unless this deployment really does collect before goods leave (#211).
DELIVERY_ORDER_REQUIRES_PAID_OR_CREDIT_SALES_ORDER=false
MIN_SPAN_HOURS_FOR_DELIVERIES=0

# Product photos (spec 003). Public: the API serves this directory at /images/ without
# authentication, so nothing private belongs in it. Instances that share a database should share
# this directory too.
IMAGES_DIR=images
# Prefix for image URLs in responses, for clients on another origin (e.g. https://api.example.com).
# Empty gives relative /images/<file> URLs.
IMAGES_BASE_URL=
# Proof-of-delivery captures and driver license photos are private: the API streams them to
# authenticated users only, so keep them outside IMAGES_DIR and never serve them from nginx.
POD_DIR=pod
# Driver license photos of vehicle operators (spec 021). Instances that share a database should
# share this directory too.
LICENSE_PHOTOS_DIR=license-photos

# Expiry sweep (uv run python -m app.jobs.expire_orders). An order confirmed this many days ago
# and still neither paid nor delivered is cancelled, releasing the stock it reserved. 0 disables.
UNPAID_ORDER_EXPIRY_DAYS=2
# The longer window for an order somebody scheduled — a live delivery order, or a promise date
# still ahead. 0 exempts those from the sweep entirely.
SCHEDULED_ORDER_EXPIRY_DAYS=30

# Pagaré printed on an unpaid credit sale receipt (#230). The default is legacy's text
# (Web.config PromissoryNoteContent); {customer}, {balance}, {due_date} and {issuer} are filled in.
# PROMISSORY_NOTE_TEMPLATE=
