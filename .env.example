APP_NAME=mbe-api
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+aiomysql://user:password@localhost/mbe

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_RECOVERY_TOKEN_EXPIRE_HOURS=24

USER_SETTINGS_MODE=Managed

# Delivery (spec 012). Spec 013 retired IN_TRANSIT_WAREHOUSE_ID: there is one in-transit
# location per facility now, found by its flag, so there is nothing left to configure.
DELIVERY_ORDER_APPROVAL_REQUIRED=false
DELIVERY_ORDER_REQUIRES_PAID_OR_CREDIT_SALES_ORDER=false
MIN_SPAN_HOURS_FOR_DELIVERIES=0
POD_DIR=pod

# Expiry sweep (uv run python -m app.jobs.expire_orders). An order confirmed this many days ago
# and still neither paid nor delivered is cancelled, releasing the stock it reserved. 0 disables.
UNPAID_ORDER_EXPIRY_DAYS=2
